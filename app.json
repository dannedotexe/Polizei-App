{
  "expo": {
    "name": "Polizei App",
    "slug": "polizei-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polizei.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Die App benötigt Ihren Standort für die Kartenfunktion.",
        "NSLocationAlwaysUsageDescription": "Die App benötigt Ihren Standort für die Einsatznavigation."
      }
    },
    "android": {
      "package": "com.polizei.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Standortzugriff für Einsatznavigation erforderlich."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "polizei-app"
  }
}
