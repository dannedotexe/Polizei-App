{
  "expo": {
    "name": "Polizei App",
    "slug": "polizei-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polizei.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Die App benötigt Ihren Standort für die Kartenfunktion.",
        "NSLocationAlwaysUsageDescription": "Die App benötigt Ihren Standort für die Einsatznavigation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1628"
      },
      "package": "com.polizei.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Standortzugriff für Einsatznavigation erforderlich."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "polizei-app"
  }
}
